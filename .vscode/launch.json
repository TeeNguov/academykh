{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Next.js Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Frontend: Open Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev"
    },
    {
      "name": "Backend: Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.academykh.AcademyKhApplication",
      "projectName": "academy-kh-backend",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Frontend + Backend",
      "configurations": [
        "Frontend: Next.js Dev",
        "Backend: Spring Boot"
      ],
      "stopAll": true
    }
  ]
}
